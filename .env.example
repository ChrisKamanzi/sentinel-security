# Frontend environment. Copy to .env.development.local (git-ignored) for local dev.
# Never put secrets here: every VITE_* value is bundled into browser code.

# Unset = demo mode with bundled data (what the Lovable preview uses).
# Local FastAPI through the Vite dev proxy (include the /api/v1 prefix exactly once):
VITE_API_BASE_URL=/api/v1
# Deployed backend instead (add this site's origin to the backend's CORS_ORIGINS):
# VITE_API_BASE_URL=https://api.example.com/api/v1

# The two settings below are read from the shell environment, NOT from .env files
# (Vite only loads VITE_* variables). Example: API_PROXY_TARGET=http://127.0.0.1:9000 bun run dev
#
# Where the browser-side dev proxy sends /api/v1. Default: http://127.0.0.1:8001
# API_PROXY_TARGET=http://127.0.0.1:8001
# Origin that server-side rendering calls directly. Falls back to API_PROXY_TARGET,
# then http://127.0.0.1:8001
# API_INTERNAL_URL=http://127.0.0.1:8001
