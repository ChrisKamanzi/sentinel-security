APP_NAME=AutoPentest AI
DATABASE_URL=sqlite:///./autopentest.db
API_V1_PREFIX=/api/v1
DEBUG=true

# Comma-separated browser origins allowed to call the API (your frontend's
# exact origin, e.g. http://localhost:5173). Empty = CORS disabled.
CORS_ORIGINS=

# Local development only: allow loopback/private targets such as 127.0.0.1.
# Cloud metadata / link-local addresses are always blocked.
ALLOW_PRIVATE_TARGETS=false

# Optional absolute tool paths (empty = auto-detect on a fixed safe PATH)
NMAP_PATH=
NMAP_TIMEOUT_SECONDS=900
NUCLEI_PATH=
NUCLEI_TIMEOUT_SECONDS=1800
FFUF_PATH=
# Hard ceiling per FFUF invocation (one per discovered web service)
FFUF_TIMEOUT_SECONDS=600

# OWASP ZAP baseline (Docker). Image must be pulled first: docker pull zaproxy/zap-stable
ZAP_DOCKER_IMAGE=zaproxy/zap-stable
# Lab only: share the Juice Shop container's network so http://127.0.0.1:3000 reaches it
ZAP_DOCKER_NETWORK=
ZAP_MEMORY=2g
ZAP_TIMEOUT_SECONDS=900

# Claude AI analyst. Server-side only -- never put keys in frontend code.
# Required for AI analysis; it is passed explicitly to the SDK, so OAuth /
# `ant auth login` profiles on the machine are never used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=64000
# Data minimization for the analyst: max findings sent, max chars per text field
AI_MAX_FINDINGS=150
AI_MAX_FIELD_CHARS=1500
